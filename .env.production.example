APP_DOMAIN=copilot.bitcoinchange.co.il
APP_NAME=BC Workspace API

POSTGRES_DB=bc_workspace
POSTGRES_USER=bc_workspace
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

MEDIAWIKI_API_URL=https://wiki.bitcoinchange.co.il/api.php
MEDIAWIKI_BOT_USERNAME=CHANGE_ME
MEDIAWIKI_BOT_PASSWORD=CHANGE_ME

OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=60

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

COPILOT_RETRIEVAL_MODE=lexical

AUTH_COOKIE_NAME=bc_workspace_session
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
