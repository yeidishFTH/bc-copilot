APP_NAME=Bitcoin Change Copilot API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://bc_copilot:bc_copilot_dev_password@localhost:5432/bc_copilot
DATABASE_ECHO=false

AUTH_COOKIE_NAME=bc_workspace_session
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

MEDIAWIKI_API_URL=https://wiki.bitcoinchange.co.il/api.php
MEDIAWIKI_BOT_USERNAME=
MEDIAWIKI_BOT_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=60

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100

COPILOT_RETRIEVAL_MODE=lexical
